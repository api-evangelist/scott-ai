          "name": "Exchange Oauth Token Endpoint",
          "request": {
            "name": "Exchange Oauth Token Endpoint",
            "description": {
              "content": "Exchange a Stytch OAuth token for a session token and JWT.\n\nCalled by the browser app after Stytch redirects back with ?token=xxx.\nIntentionally unauthenticated — this endpoint IS the authentication mechanism.\nThe Stytch secret key never leaves the server.",
