{
  "opencollection": "1.0.0",
  "info": {
    "name": "One-Shot access issues API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "issues",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "File Issue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/issues",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "File Issue"
        }
      ]
    }
  ],
  "bundled": true
}