{
  "opencollection": "1.0.0",
  "info": {
    "name": "One-Shot access orgs API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "orgs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update Org External Sharing",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/orgs/:org_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Owners-only toggle of org-wide external sharing.\n\n- Non-owners (or non-members) get 403.\n- Missing org → 404.\n- Idempotent: when the value already matches the existing row, no audit-log row is written\n  and the existing row is returned unchanged."
        }
      ]
    }
  ],
  "bundled": true
}